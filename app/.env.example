# EV ChargeOps: configuração por ambiente.
#
# Este arquivo é o modelo versionado. Copie para `.env` e ajuste o que precisar:
#
#     cp .env.example .env
#
# O `.env` real fica fora do repositório (ver .gitignore). Todos os valores
# abaixo já são os defaults embutidos em `chargeops/settings.py`, então a
# aplicação sobe em desenvolvimento mesmo sem nenhum `.env`. O arquivo existe
# para tornar visível o que é configurável, e para o dia em que a plataforma
# rodar em outro lugar que não a máquina de quem desenvolve.

# --- Django ---------------------------------------------------------------
# Em produção, gere uma chave nova e nunca a versione:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=django-insecure-dev-only-nao-usar-em-producao-troque-no-env

# 1 liga o modo de depuração (páginas de erro detalhadas). Use 0 em produção.
DJANGO_DEBUG=1

# Hosts autorizados a servir a aplicação, separados por vírgula.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL -----------------------------------------------------------
# O banco precisa ser PostgreSQL 13 ou superior: a migração 0002 usa
# EXCLUSION CONSTRAINT com a extensão btree_gist, que só é instalável por
# um usuário comum (o dono do banco) a partir dessa versão.
DB_NAME=chargeops
DB_USER=chargeops
DB_PASSWORD=chargeops_dev
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Regra de negócio -----------------------------------------------------
# Fuso civil do condomínio. Os timestamps são persistidos em UTC, mas a
# competência da fatura é decidida neste fuso: a sessão que começa 30/06
# às 23h40 BRT pertence a junho, ainda que em UTC já seja 01/07.
CONDOMINIUM_TIME_ZONE=America/Sao_Paulo
